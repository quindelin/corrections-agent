# Copy to .env (never commit .env).

# Where TrueForge runs. Local `npx @truefoundry/trueforge@latest` serves http://localhost:8790.
TRUEFORGE_BASE_URL=http://localhost:8790

# Only when your TrueForge server has OIDC login on (hosted setups). Local npx needs none.
TRUEFORGE_TOKEN=

# Override agent/agent.json without editing it (handy when teammates use different providers).
# The model must exist in Settings → Models, written as provider/model, e.g. openai/gpt-5.2.
TF_MODEL=
TF_AGENT_NAME=

# Only for "skill_mode": "git" in agent/agent.json: your PUBLIC repo, so TrueForge can clone the skill.
# SKILL_REPO_URL=https://github.com/you/your-repo

# Optional. Without DATABASE_URL, state stays in local files under .cache/, which is safe for one instance only.
# With it, run `npm run store -- migrate` once before starting the service.
# DATABASE_URL=
# Days to keep reports. Default 90.
# REDLINE_RETENTION_DAYS=90
# Keys the hash of client addresses in rate limits. Must match on every instance. Falls back to REDLINE_API_KEY.
# REDLINE_RATE_LIMIT_SECRET=

# Model keys do NOT go here: add them in the TrueForge UI (Settings → Models). Agents never hold keys.

# Only for containers. Leave these unset for local use; docs/deploy.md explains them.
# REDLINE_MCP_URL=http://mcp:8791/mcp   overrides the MCP URL in agent/agent.json
# MCP_HOST=0.0.0.0                      what the MCP server binds to (default 127.0.0.1)
# REDLINE_HOST=0.0.0.0                  what the API binds to (default 127.0.0.1)
# REDLINE_GIT_SHA=abc1234               stands in for git when there's no .git

# Stripe, set up by following docs/stripe-setup.md. Use sandbox values until you go live. All three change together.
# STRIPE_PAYMENT_LINK=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
