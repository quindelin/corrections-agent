# Copy to .env (never commit .env).

# Where TrueForge runs. Local `npx @truefoundry/trueforge@latest` serves http://localhost:8790.
TRUEFORGE_BASE_URL=http://localhost:8790

# Only when your TrueForge server has OIDC login on (hosted setups). Local npx needs none.
TRUEFORGE_TOKEN=

# Override agent/agent.json without editing it (handy when teammates use different providers).
# The model must exist in Settings → Models, written as provider/model, e.g. openai/gpt-5.2.
TF_MODEL=
TF_AGENT_NAME=

# Only for "skill_mode": "git" in agent/agent.json: your PUBLIC repo, so TrueForge can clone the skill.
# SKILL_REPO_URL=https://github.com/you/your-repo

# Model keys do NOT go here: add them in the TrueForge UI (Settings → Models). Agents never hold keys.
