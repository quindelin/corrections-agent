{
  "name": "redline",
  "version": "0.1.0",
  "private": true,
  "description": "A self-improving agent that answers building permit correction letters, built on TrueForge.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "mcp": "tsx mcp/server.ts",
    "demo": "tsx demo/server.ts",
    "setup": "tsx scripts/setup.ts",
    "run-evals": "tsx scripts/run-evals.ts",
    "improve": "tsx scripts/improve.ts",
    "export-session": "tsx scripts/export-session.ts",
    "score": "tsx evals/score.ts",
    "real:build": "tsx realdata/build-seattle.ts",
    "real:run": "tsx realdata/run.ts",
    "real:improve": "tsx realdata/improve.ts",
    "store": "tsx demo/store-cli.ts",
    "test:demo": "node --import tsx --test --test-concurrency=1 --test-timeout=120000 demo/*.test.ts",
    "test:payments": "node --import tsx --test --test-timeout=120000 demo/payments.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@truefoundry/trueforge-sdk": "^0.180.0",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@electric-sql/pglite-socket": "^0.2.17",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
