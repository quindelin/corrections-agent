# Copy to deploy/.env, which git ignores. Placeholders only: never commit real values.

# ---------- API ----------
# Required. Emris sends this as the x-redline-key header. Make one with: openssl rand -hex 32
REDLINE_API_KEY=replace-with-a-long-random-value
# The port published on the host. TLS isn't handled here, so put a reverse proxy in front of it.
REDLINE_PUBLIC_PORT=8792
# Overrides the model in agent/agent.json. Written as provider/model.
TF_MODEL=
# Leave both empty to keep unlocking as the free design-partner offer.
STRIPE_PAYMENT_LINK=
STRIPE_SECRET_KEY=

# ---------- Model provider, set in TrueForge at boot ----------
# Leave the key empty to set it in TrueForge's Settings → Models instead. See docs/deploy.md.
MODEL_PROVIDER_API_KEY=
# Your gateway's OpenAI-compatible base URL. Copy it from your current provider in Settings → Models.
MODEL_PROVIDER_BASE_URL=https://your-gateway.example.com/api/llm
MODEL_PROVIDER_TYPE=custom
# With MODEL_PROVIDER_MODELS, this makes the name truefoundry/claude-haiku-4-5, which agent/agent.json asks for.
MODEL_PROVIDER_NAME=truefoundry
# name=upstream-id, comma separated. Copy the upstream model id from Settings → Models.
MODEL_PROVIDER_MODELS=claude-haiku-4-5=your-upstream-model-id
